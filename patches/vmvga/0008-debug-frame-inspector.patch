+/*
+ * Debug frame inspector state (see vmsvga3d_debug_dump_frame).  The draw
+ * snapshot flag is consumed by vmsvga3d_debug_dump_draw(); the frame log,
+ * when non-NULL, records every draw, clear and blit until the next present.
+ */
+static bool vmsvga3d_debug_draw_dump_armed;
+static GString *vmsvga3d_debug_frame_log;
+
+/*
+ * Sampling profiler for the thread that services presents (QEMU's main
+ * loop).  With VMVGA_PROFILE_DIR set, creating "$dir/profile" samples the
+ * instruction pointer every 0.5 ms of that thread's CPU time for 10 s, then
+ * writes $dir/samples.txt (one hex address per line) and $dir/maps (a copy
+ * of /proc/self/maps) for tools/profile-report.py.
+ */
+#include <signal.h>
+#include <time.h>
+#include <ucontext.h>
+#include <sys/syscall.h>
+
+#define VMSVGA3D_PROFILE_MAX_SAMPLES 200000u
+
+static uintptr_t *vmsvga3d_profile_samples;
+static uintptr_t *vmsvga3d_profile_callers;
+static volatile uint32_t vmsvga3d_profile_count;
+static timer_t vmsvga3d_profile_timer;
+static int64_t vmsvga3d_profile_end;
+
+static void vmsvga3d_profile_signal(int sig, siginfo_t *info, void *opaque)
+{
+    ucontext_t *uc = opaque;
+    uint32_t n = vmsvga3d_profile_count;
+
+    (void)sig;
+    (void)info;
+    if (vmsvga3d_profile_samples != NULL && n < VMSVGA3D_PROFILE_MAX_SAMPLES) {
+        vmsvga3d_profile_samples[n] = (uintptr_t)uc->uc_mcontext.gregs[REG_RIP];
+        /* Top of stack: the return address when the sample hit a leaf
+         * routine such as memcpy. */
+        vmsvga3d_profile_callers[n] =
+            *(const uintptr_t *)(uintptr_t)uc->uc_mcontext.gregs[REG_RSP];
+        vmsvga3d_profile_count = n + 1;
+    }
+}
+
+static void vmsvga3d_debug_profile_tick(void)
+{
+    static int enabled = -1;
+    static const char *dir;
+    int64_t now;
+
+    if (enabled < 0) {
+        dir = getenv("VMVGA_PROFILE_DIR");
+        enabled = dir != NULL && dir[0] != '\0';
+    }
+    if (!enabled) {
+        return;
+    }
+    now = g_get_monotonic_time();
+    if (vmsvga3d_profile_end == 0) {
+        g_autofree char *trigger = g_build_filename(dir, "profile", NULL);
+        struct sigaction sa = { 0 };
+        struct sigevent sev = { 0 };
+        struct itimerspec its = { 0 };
+        clockid_t clock;
+
+        if (!g_file_test(trigger, G_FILE_TEST_EXISTS)) {
+            return;
+        }
+        g_unlink(trigger);
+        if (vmsvga3d_profile_samples == NULL) {
+            vmsvga3d_profile_samples =
+                g_new0(uintptr_t, VMSVGA3D_PROFILE_MAX_SAMPLES);
+            vmsvga3d_profile_callers =
+                g_new0(uintptr_t, VMSVGA3D_PROFILE_MAX_SAMPLES);
+        }
+        vmsvga3d_profile_count = 0;
+        sa.sa_sigaction = vmsvga3d_profile_signal;
+        sa.sa_flags = SA_SIGINFO | SA_RESTART;
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGPROF, &sa, NULL);
+        if (pthread_getcpuclockid(pthread_self(), &clock) != 0) {
+            return;
+        }
+        sev.sigev_notify = SIGEV_THREAD_ID;
+        sev.sigev_signo = SIGPROF;
+        sev._sigev_un._tid = (pid_t)syscall(SYS_gettid);
+        if (timer_create(clock, &sev, &vmsvga3d_profile_timer) != 0) {
+            fprintf(stderr, "VMVGA-PROFILE timer_create failed\n");
+            return;
+        }
+        its.it_value.tv_nsec = 500000;
+        its.it_interval.tv_nsec = 500000;
+        timer_settime(vmsvga3d_profile_timer, 0, &its, NULL);
+        vmsvga3d_profile_end = now + 10 * G_USEC_PER_SEC;
+        fprintf(stderr, "VMVGA-PROFILE started\n");
+        return;
+    }
+    if (now >= vmsvga3d_profile_end) {
+        g_autofree char *path = g_build_filename(dir, "samples.txt", NULL);
+        g_autofree char *maps_path = g_build_filename(dir, "maps", NULL);
+        g_autofree char *maps = NULL;
+        g_autoptr(GString) out = g_string_new(NULL);
+        uint32_t i, count;
+
+        timer_delete(vmsvga3d_profile_timer);
+        count = vmsvga3d_profile_count;
+        for (i = 0; i < count; i++) {
+            g_string_append_printf(out, "%" PRIxPTR " %" PRIxPTR "\n",
+                                   vmsvga3d_profile_samples[i],
+                                   vmsvga3d_profile_callers[i]);
+        }
+        g_file_set_contents(path, out->str, out->len, NULL);
+        if (g_file_get_contents("/proc/self/maps", &maps, NULL, NULL)) {
+            g_file_set_contents(maps_path, maps, -1, NULL);
+        }
+        fprintf(stderr, "VMVGA-PROFILE wrote %u samples\n", count);
+        vmsvga3d_profile_end = 0;
+    }
+}
+
+/*
+ * VMVGA_FPS=1: every 5 s print presents (StretchBlt) and draws per second.
+ */
+static uint64_t vmsvga3d_debug_fps_draws;
+static struct {
+    uint64_t sync, fifo_runs, fences, irqs, stalls;
+    uint64_t cb_submit, cb_done, cb_yield, cb_irq, cb_bh;
+} vmsvga3d_debug_fps_counts;
+
+static void vmsvga3d_debug_fps_present(void)
+{
+    static int enabled = -1;
+    static int64_t window_start;
+    static uint64_t presents;
+    static uint64_t draws_at_start;
+    int64_t now;
+
+    if (enabled < 0) {
+        enabled = g_strcmp0(getenv("VMVGA_FPS"), "1") == 0;
+    }
+    if (!enabled) {
+        return;
+    }
+    now = g_get_monotonic_time();
+    if (window_start == 0) {
+        window_start = now;
+        draws_at_start = vmsvga3d_debug_fps_draws;
+    }
+    presents++;
+    if (now - window_start >= 5 * G_USEC_PER_SEC) {
+        double secs = (now - window_start) / (double)G_USEC_PER_SEC;
+
+        fprintf(stderr, "VMVGA-FPS presents/s=%.1f draws/s=%.0f sync/s=%.0f "
+                "fifo-runs/s=%.0f fences/s=%.0f irqs/s=%.0f stalls/s=%.0f\n",
+                presents / secs,
+                (vmsvga3d_debug_fps_draws - draws_at_start) / secs,
+                vmsvga3d_debug_fps_counts.sync / secs,
+                vmsvga3d_debug_fps_counts.fifo_runs / secs,
+                vmsvga3d_debug_fps_counts.fences / secs,
+                vmsvga3d_debug_fps_counts.irqs / secs,
+                vmsvga3d_debug_fps_counts.stalls / secs);
+        fprintf(stderr, "VMVGA-FPS cb-submit/s=%.0f cb-done/s=%.0f cb-yield/s=%.0f "
+                "cb-irq/s=%.0f cb-bh/s=%.0f\n",
+                vmsvga3d_debug_fps_counts.cb_submit / secs,
+                vmsvga3d_debug_fps_counts.cb_done / secs,
+                vmsvga3d_debug_fps_counts.cb_yield / secs,
+                vmsvga3d_debug_fps_counts.cb_irq / secs,
+                vmsvga3d_debug_fps_counts.cb_bh / secs);
+        memset(&vmsvga3d_debug_fps_counts, 0, sizeof(vmsvga3d_debug_fps_counts));
+        window_start = now;
+        presents = 0;
+        draws_at_start = vmsvga3d_debug_fps_draws;
+    }
+}
+
+static void G_GNUC_PRINTF(1, 2) vmsvga3d_debug_frame_logf(const char *fmt, ...)
+{
+    va_list ap;
+
+    if (vmsvga3d_debug_frame_log == NULL) {
+        return;
+    }
+    va_start(ap, fmt);
+    g_string_append_vprintf(vmsvga3d_debug_frame_log, fmt, ap);
+    va_end(ap);
+}
