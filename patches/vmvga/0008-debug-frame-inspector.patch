+/*
+ * Debug draw snapshot, armed by the frame dumper (VMVGA_DUMP_DIR trigger).
+ * The first successful draw whose pixel shader id equals VMVGA_DUMP_PS
+ * writes the bound VS/PS bytecode, every valid shader constant, the bound
+ * textures and the set render states to $VMVGA_DUMP_DIR/draw_ps<id>_*.
+ */
+static void vmsvga3d_debug_dump_draw(
+    struct vmsvga_state_s *s, VMSVGA3DContext *context, uint32_t cid,
+    const SVGA3dVertexDecl *decls, uint32_t decl_count,
+    const SVGA3dVertexDivisor *divisors, uint32_t divisor_count,
+    const VMSVGA3DD3D9VertexElement *elements,
+    const VMSVGA3DD3D9VertexStream *streams, uint32_t stream_count)
+{
+    const char *dir = vmsvga3d_debug_draw_dump_armed ? getenv("VMVGA_DUMP_DIR") : NULL;
+    const char *want = dir != NULL ? getenv("VMVGA_DUMP_PS") : NULL;
+    uint32_t vs = context->bound_shader[SVGA3D_SHADERTYPE_VS - SVGA3D_SHADERTYPE_MIN];
+    uint32_t ps = context->bound_shader[SVGA3D_SHADERTYPE_PS - SVGA3D_SHADERTYPE_MIN];
+    g_autoptr(GString) out = NULL;
+    g_autofree char *name = NULL;
+    g_autofree char *path = NULL;
+    uint32_t t, r, i;
+
+    static uint32_t done[16];
+    static uint32_t done_count;
+    g_auto(GStrv) wanted = NULL;
+    bool match = false;
+
+    if (!vmsvga3d_debug_draw_dump_armed || dir == NULL || want == NULL) {
+        return;
+    }
+    if (vmsvga3d_debug_frame_log == NULL) {
+        /* The frame after the trigger is over. */
+        vmsvga3d_debug_draw_dump_armed = false;
+        done_count = 0;
+        return;
+    }
+    /* VMVGA_DUMP_PS is a comma-separated list; dump the first draw of each. */
+    wanted = g_strsplit(want, ",", 16);
+    for (i = 0; wanted[i] != NULL; i++) {
+        if (strtoul(wanted[i], NULL, 10) == ps) {
+            match = true;
+        }
+    }
+    for (i = 0; i < done_count; i++) {
+        if (done[i] == ps) {
+            match = false;
+        }
+    }
+    if (!match || done_count == ARRAY_SIZE(done)) {
+        return;
+    }
+    done[done_count++] = ps;
+
+    out = g_string_new(NULL);
+    g_string_append_printf(out, "cid %u vs %u ps %u\n", cid, vs, ps);
+    for (r = SVGA3D_RT_DEPTH; r < SVGA3D_RT_MAX; r++) {
+        if (context->render_targets[r].sid != SVGA3D_INVALID_ID) {
+            g_string_append_printf(out, "rt %u sid %u face %u mip %u\n", r,
+                                   context->render_targets[r].sid,
+                                   context->render_targets[r].face,
+                                   context->render_targets[r].mipmap);
+        }
+    }
+    for (t = 0; t < SVGA3D_NUM_SHADERTYPE_PREDX; t++) {
+        const char *kind = t == SVGA3D_SHADERTYPE_VS - SVGA3D_SHADERTYPE_MIN ? "vs" : "ps";
+        uint32_t shid = context->bound_shader[t];
+
+        if (shid < SVGA3D_MAX_SHADERIDS) {
+            vmsvga3d_debug_write_shader(dir, kind, context->shader[t][shid]);
+        }
+        for (r = 0; r < SVGA3D_CONSTREG_MAX; r++) {
+            const VMSVGA3DShaderConstant *c = &context->shader_float[t][r];
+            float f[4];
+
+            if (!c->valid) {
+                continue;
+            }
+            memcpy(f, c->values, sizeof(f));
+            g_string_append_printf(out, "%s c%u = %g %g %g %g\n", kind, r,
+                                   f[0], f[1], f[2], f[3]);
+        }
+        for (r = 0; r < SVGA3D_CONSTINTREG_MAX; r++) {
+            const VMSVGA3DShaderConstant *c = &context->shader_int[t][r];
+
+            if (c->valid) {
+                g_string_append_printf(out, "%s i%u = %d %d %d %d\n", kind, r,
+                                       (int32_t)c->values[0], (int32_t)c->values[1],
+                                       (int32_t)c->values[2], (int32_t)c->values[3]);
+            }
+        }
+        for (r = 0; r < SVGA3D_CONSTBOOLREG_MAX; r++) {
+            const VMSVGA3DShaderConstant *c = &context->shader_bool[t][r];
+
+            if (c->valid) {
+                g_string_append_printf(out, "%s b%u = %u\n", kind, r, c->values[0]);
+            }
+        }
+    }
+    for (i = 0; i < VMSVGA3D_MAX_SAMPLERS; i++) {
+        for (t = SVGA3D_TS_MIN; t < SVGA3D_TS_MAX; t++) {
+            if (context->texture_state[i][t].valid) {
+                g_string_append_printf(out, "ts stage %u name %u = 0x%x\n", i, t,
+                                       context->texture_state[i][t].value);
+            }
+        }
+    }
+    /* Shadow copy (what the guest uploaded) of level 0 of each bound texture. */
+    for (i = 0; i < VMSVGA3D_MAX_SAMPLERS; i++) {
+        const VMSVGA3DStateValue *bind = &context->texture_state[i][SVGA3D_TS_BIND_TEXTURE];
+        VMSVGA3DSurface *tex;
+        g_autofree char *tname = NULL;
+        g_autofree char *tpath = NULL;
+
+        if (!bind->valid || bind->value >= SVGA3D_MAX_SURFACE_IDS ||
+            (tex = s->svga3d->surfaces[bind->value]) == NULL ||
+            tex->mip_count == 0 || tex->mips == NULL || tex->mips[0].data == NULL) {
+            continue;
+        }
+        g_string_append_printf(out, "tex stage %u sid %u fmt %u %ux%ux%u pitch %u "
+                               "mips %u flags 0x%llx data %u\n", i, bind->value,
+                               (unsigned)tex->format, tex->mips[0].size.width,
+                               tex->mips[0].size.height, tex->mips[0].size.depth,
+                               tex->mips[0].pitch, tex->mip_count,
+                               (unsigned long long)tex->surface_flags,
+                               tex->mips[0].data_size);
+        tname = g_strdup_printf("draw_ps%u_tex%u_sid%u_fmt%u_%ux%ux%u_pitch%u.shadow",
+                                ps, i, bind->value, (unsigned)tex->format,
+                                tex->mips[0].size.width, tex->mips[0].size.height,
+                                tex->mips[0].size.depth, tex->mips[0].pitch);
+        tpath = g_build_filename(dir, tname, NULL);
+        g_file_set_contents(tpath, (const char *)tex->mips[0].data,
+                            tex->mips[0].data_size, NULL);
+    }
+    for (r = SVGA3D_RS_MIN; r < SVGA3D_RS_MAX; r++) {
+        if (context->render_state[r].valid) {
+            g_string_append_printf(out, "rs %u = 0x%x\n", r,
+                                   context->render_state[r].value);
+        }
+    }
+    for (i = 0; i < decl_count; i++) {
+        g_string_append_printf(
+            out, "decl %u type %u method %u usage %u index %u sid %u offset %u "
+            "stride %u divisor 0x%x\n", i, decls[i].identity.type,
+            decls[i].identity.method, decls[i].identity.usage,
+            decls[i].identity.usageIndex, decls[i].array.surfaceId,
+            decls[i].array.offset, decls[i].array.stride,
+            i < divisor_count ? divisors[i].value : 0);
+    }
+    for (i = 0; i <= decl_count; i++) {
+        g_string_append_printf(out, "elem %u stream %u offset %u type %u method %u "
+                               "usage %u index %u\n", i, elements[i].stream,
+                               elements[i].offset, elements[i].type,
+                               elements[i].method, elements[i].usage,
+                               elements[i].usage_index);
+    }
+    for (i = 0; i < stream_count; i++) {
+        VMSVGA3DSurface *vb = streams[i].surface_id < SVGA3D_MAX_SURFACE_IDS
+                                  ? s->svga3d->surfaces[streams[i].surface_id]
+                                  : NULL;
+
+        g_string_append_printf(out, "stream %u sid %u offset %u stride %u freq 0x%x "
+                               "decls %u+%u\n", i, streams[i].surface_id,
+                               streams[i].source_offset, streams[i].stride,
+                               streams[i].frequency, streams[i].first_decl,
+                               streams[i].decl_count);
+        if (vb != NULL && vb->mip_count != 0 && vb->mips != NULL &&
+            vb->mips[0].data != NULL) {
+            g_autofree char *vname = g_strdup_printf("draw_ps%u_vb%u_sid%u.bin", ps,
+                                                     i, streams[i].surface_id);
+            g_autofree char *vpath = g_build_filename(dir, vname, NULL);
+
+            g_file_set_contents(vpath, (const char *)vb->mips[0].data,
+                                vb->mips[0].data_size, NULL);
+        }
+    }
+    name = g_strdup_printf("draw_ps%u.txt", ps);
+    path = g_build_filename(dir, name, NULL);
+    g_file_set_contents(path, out->str, out->len, NULL);
+    /* Read the colour targets back right after this draw, before later
+     * passes can overwrite them. */
+    {
+        g_autofree char *subname = g_strdup_printf("draw_ps%u", ps);
+        g_autofree char *sub = g_build_filename(dir, subname, NULL);
+
+        g_mkdir_with_parents(sub, 0755);
+        /* VMVGA_DUMP_ALL_RT=1: every render target, not just the bound ones. */
+        if (g_strcmp0(getenv("VMVGA_DUMP_ALL_RT"), "1") == 0) {
+            vmsvga3d_debug_dump_surfaces(s, sub, false);
+        }
+        for (r = SVGA3D_RT_COLOR0;
+             g_strcmp0(getenv("VMVGA_DUMP_ALL_RT"), "1") != 0 && r <= SVGA3D_RT_COLOR7;
+             r++) {
+            uint32_t sid = context->render_targets[r].sid;
+            VMSVGA3DSurface *rt;
+            VMSVGA3DSurfaceImage *image;
+            g_autofree char *rname = NULL;
+            g_autofree char *rpath = NULL;
+
+            if (sid >= SVGA3D_MAX_SURFACE_IDS ||
+                (rt = s->svga3d->surfaces[sid]) == NULL ||
+                rt->mip_count == 0 || rt->mips == NULL) {
+                continue;
+            }
+            image = &rt->mips[0];
+            if (image->data == NULL ||
+                !vmsvga3d_surface_readback_to_shadow(s, rt, image, 0)) {
+                fprintf(stderr, "VMVGA-FRAMEDUMP draw rt sid=%u readback failed\n", sid);
+                continue;
+            }
+            rname = g_strdup_printf("sid%u_fmt%u_%ux%u_pitch%u.raw", sid,
+                                    (unsigned)rt->format, image->size.width,
+                                    image->size.height, image->pitch);
+            rpath = g_build_filename(sub, rname, NULL);
+            g_file_set_contents(rpath, (const char *)image->data,
+                                (gssize)image->data_size, NULL);
+        }
+    }
+    fprintf(stderr, "VMVGA-FRAMEDUMP draw snapshot ps=%u written\n", ps);
+}
