+/* Write level 0 of every render target (and optionally large textures) to dir. */
+static unsigned vmsvga3d_debug_dump_surfaces(struct vmsvga_state_s *s,
+                                             const char *dir, bool with_textures)
+{
+    uint32_t sid;
+    unsigned dumped = 0;
+    unsigned textures = 0;
+
+    for (sid = 0; sid < SVGA3D_MAX_SURFACE_IDS; sid++) {
+        VMSVGA3DSurface *surface = s->svga3d->surfaces[sid];
+        VMSVGA3DSurfaceImage *image;
+        g_autofree char *name = NULL;
+        g_autofree char *path = NULL;
+
+        bool is_target;
+        bool want_texture;
+
+        if (surface == NULL || surface->mip_count == 0 || surface->mips == NULL) {
+            continue;
+        }
+        is_target = (surface->surface_flags & (SVGA3D_SURFACE_HINT_RENDERTARGET |
+                                               SVGA3D_SURFACE_BIND_RENDER_TARGET)) != 0;
+        /* VMVGA_DUMP_TEXTURES=1: also large colour/compressed textures. */
+        want_texture = !is_target && with_textures &&
+                       textures < 120 &&
+                       (surface->format == SVGA3D_A8R8G8B8 || surface->format == SVGA3D_DXT1 ||
+                        surface->format == SVGA3D_DXT3 || surface->format == SVGA3D_DXT5 ||
+                        surface->format == SVGA3D_ATI2);
+        if (!is_target && !want_texture) {
+            continue;
+        }
+        if (want_texture && surface->mips[0].size.width >= 256) {
+            textures++;
+        }
+        image = &surface->mips[0];
+        if (image->size.width < (is_target ? 64u : 256u) || image->size.height < 64 ||
+            image->data == NULL || image->data_size == 0) {
+            continue;
+        }
+        bool shadow_only = false;
+
+        if (!vmsvga3d_surface_readback_to_shadow(s, surface, image, 0)) {
+            if (!want_texture) {
+                fprintf(stderr, "VMVGA-FRAMEDUMP sid=%u readback failed\n", sid);
+                continue;
+            }
+            /* Compressed textures can't be read back: dump the CPU shadow,
+             * i.e. exactly what vmvga uploads to the host GPU. */
+            shadow_only = true;
+        }
+        name = g_strdup_printf("sid%u_fmt%u_%ux%u_pitch%u%s.raw", sid,
+                               (unsigned)surface->format, image->size.width,
+                               image->size.height, image->pitch,
+                               shadow_only ? "_shadow" : "");
+        path = g_build_filename(dir, name, NULL);
+        if (g_file_set_contents(path, (const char *)image->data,
+                                (gssize)image->data_size, NULL)) {
+            dumped++;
+        }
+    }
+    return dumped;
+}
+
+/*
+ * Debug frame inspector.  With VMVGA_DUMP_DIR set, creating
+ * "$VMVGA_DUMP_DIR/trigger" makes the next present (StretchBlt) read every
+ * render-target surface back from the GPU and write its level 0 as raw data:
+ *   sid<sid>_fmt<svga-format>_<w>x<h>_pitch<pitch>.raw
+ * The trigger file is removed after the dump.
+ */
+static void vmsvga3d_debug_dump_frame(struct vmsvga_state_s *s)
+{
+    const char *dir = getenv("VMVGA_DUMP_DIR");
+    g_autofree char *trigger = NULL;
+    unsigned dumped;
+
+    if (dir == NULL || s->svga3d == NULL) {
+        return;
+    }
+    if (vmsvga3d_debug_frame_log != NULL) {
+        g_autofree char *log_path = g_build_filename(dir, "frame.txt", NULL);
+
+        g_file_set_contents(log_path, vmsvga3d_debug_frame_log->str,
+                            vmsvga3d_debug_frame_log->len, NULL);
+        fprintf(stderr, "VMVGA-FRAMEDUMP frame log written (%zu bytes)\n",
+                vmsvga3d_debug_frame_log->len);
+        g_string_free(vmsvga3d_debug_frame_log, true);
+        vmsvga3d_debug_frame_log = NULL;
+    }
+    trigger = g_build_filename(dir, "trigger", NULL);
+    if (!g_file_test(trigger, G_FILE_TEST_EXISTS)) {
+        return;
+    }
+    g_unlink(trigger);
+    vmsvga3d_debug_draw_dump_armed = true;
+
+    dumped = vmsvga3d_debug_dump_surfaces(
+        s, dir, g_strcmp0(getenv("VMVGA_DUMP_TEXTURES"), "1") == 0);
+    fprintf(stderr, "VMVGA-FRAMEDUMP wrote %u surfaces to %s\n", dumped, dir);
+    vmsvga3d_debug_frame_log = g_string_new(NULL);
+}
